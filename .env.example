# =============================================================================
# Pawzaroo — environment template.
# Copy to `.env` (untracked) and fill in real values for local development.
# Compose reads this file automatically; CI/CD pulls secrets from its own vault.
# =============================================================================

# ----- Application --------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development

# ----- Postgres -----------------------------------------------------------
POSTGRES_DB=pawzaroo
POSTGRES_USER=pawzaroo
POSTGRES_PASSWORD=pawzaroo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Redis --------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Kafka --------------------------------------------------------------
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_API_GROUP=pawzaroo-api
KAFKA_WORKER_GROUP=pawzaroo-worker

# ----- Object storage (S3 / MinIO) ----------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=pawzaroo-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true

# ----- Auth ---------------------------------------------------------------
# 32+ random chars in prod. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_xxxxxxxxxxxxx
JWT_ISSUER=pawzaroo
JWT_AUDIENCE=pawzaroo.clients
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# ----- Frontend -----------------------------------------------------------
VITE_API_BASE=/api
VITE_APP_VERSION=local-dev

# ----- Container registry (used by docker-compose + CI builds) -----------
REGISTRY=ghcr.io
IMAGE_PREFIX=your-org/pawzaroo
IMAGE_TAG=latest

# ----- Observability ------------------------------------------------------
LOG_LEVEL=Information
