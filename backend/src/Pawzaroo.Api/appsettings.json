{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=pawzaroo;Username=pawzaroo;Password=pawzaroo",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "pawzaroo",
    "Audience": "pawzaroo.clients",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS_xxxxxxxxxxxxx",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "pawzaroo-api",
    "SecurityProtocol": "Plaintext",
    "RetryAttempts": 3,
    "RetryBaseDelayMs": 500,
    "EnableInProcessConsumer": true,
    "Topics": {
      "UserEvents":        "pawzaroo.user.events",
      "RbacEvents":        "pawzaroo.rbac.events",
      "PostEvents":        "pawzaroo.feed.post.events",
      "CommentEvents":     "pawzaroo.feed.comment.events",
      "AdoptionEvents":    "pawzaroo.adoption.events",
      "MessageEvents":     "pawzaroo.message.events",
      "VetEvents":         "pawzaroo.vet.events",
      "AppointmentEvents": "pawzaroo.appointment.events",
      "StoreEvents":       "pawzaroo.marketplace.store",
      "ProductEvents":     "pawzaroo.marketplace.product",
      "InventoryEvents":   "pawzaroo.marketplace.inventory",
      "OrderEvents":       "pawzaroo.marketplace.order",
      "PaymentEvents":     "pawzaroo.marketplace.payment",
      "ReviewEvents":      "pawzaroo.marketplace.review",
      "Notifications":     "pawzaroo.notifications",
      "Audit":             "pawzaroo.audit"
    }
  },
  "Storage": {
    "Endpoint": "http://localhost:9000",
    "Region": "us-east-1",
    "Bucket": "pawzaroo-media",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "UsePathStyle": true,
    "PublicBaseUrl": null
  },
  "RateLimiting": {
    "GlobalPerMinute": 200,
    "AuthPerMinute": 10,
    "WritesPerMinute": 60
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"]
  },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft": "Warning", "System": "Warning" } }
  },
  "AllowedHosts": "*"
}
